# ============================================================
# SANJEEVANI GRID ENVIRONMENT CONFIGURATION
# ============================================================

# Gemini AI API Key (Required for live AI explanations)
GEMINI_API_KEY=

# Backend Service Port (Default: 8000, Render sets $PORT dynamically)
PORT=8000

# Frontend URL (For Backend CORS configuration in production)
FRONTEND_URL=

# Backend API Base URL (Used by Vite Frontend client to connect to FastAPI backend)
# In local dev: http://localhost:8000
# On Render: https://sanjeevani-api.onrender.com (or leave blank to fallback to simulated mode)
VITE_API_BASE_URL=
